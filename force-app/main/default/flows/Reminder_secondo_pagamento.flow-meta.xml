    <decisions>
        <name>Link_pagamento_aggiornato</name>
        <label>Link pagamento aggiornato?</label>
        <locationX>578</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>Incrementa_tentativi_link</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non ancora aggiornato</defaultConnectorLabel>
        <rules>
            <name>Link_aggiornato</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Verifica_link_pagamento.Link_pagamento__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Link_pagamento__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Lead_or_Contact</targetReference>
            </connector>
            <label>Link aggiornato</label>
        </rules>
        <rules>
            <name>Tentativi_esauriti</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>tentativiLink</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Lead_or_Contact</targetReference>
            </connector>
            <label>Tentativi esauriti</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Days_to_Event</name>
        <label>Check Days to Event</label>
        <locationX>1898</locationX>
        <locationY>576</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X30_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Data_ricezione_saldo__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Days_to_event__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Genera_link_di_pagamento</targetReference>
            </connector>
            <label>30 Days</label>
        </rules>
        <rules>
            <name>X7_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_to_event__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recipient_Fabio</targetReference>
            </connector>
            <label>7 Days</label>
        </rules>
        <rules>
            <name>Today_plus_7</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>EventPlus7</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recipient_Sabrina</targetReference>
            </connector>
            <label>Today plus 7</label>
        </rules>
    </decisions>
