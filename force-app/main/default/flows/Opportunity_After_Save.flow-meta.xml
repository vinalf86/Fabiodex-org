            </value>
        </inputAssignments>
        <inputAssignments>
            <name>ReminderSentChanged</name>
            <value>
                <elementReference>ReminderSentChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>ContemporaneiChanged</name>
            <value>
                <elementReference>ContemporaneiChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PriorStageClosedLost</name>
            <value>
                <elementReference>PriorStageClosedLostFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TuttoOrganizzatoChanged</name>
            <value>
                <elementReference>TuttoOrganizzatoChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>EventStartDateChanged</name>
            <value>
                <elementReference>EventStartDateChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>EventEndDateChanged</name>
            <value>
                <elementReference>EventEndDateChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>LeadChanged</name>
            <value>
                <elementReference>LeadChangedFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>StageBecameClosedWon</name>
            <value>
                <elementReference>StageBecameClosedWonFormula</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <triggerOrder>200</triggerOrder>
</Flow>
