    <decisions>
        <name>Check_Fault_Stage</name>
        <label>Check Fault Stage</label>
        <locationX>710</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No Fault</defaultConnectorLabel>
        <rules>
            <name>Lead_Event_Fault</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Call_Opportunity_After_Save_Logic.FaultStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LeadEvent</stringValue>
                </rightValue>
            </conditions>
            <connector>
