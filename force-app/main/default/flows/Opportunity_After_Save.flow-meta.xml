    <description>Trigger su Opportunity After Save. Valuta le condizioni di ingresso (unione di quelle di Notifica_nuova_Opportunita e OpportunityAfterInsert, ora disattivati) e richiama il subflow Opportunity_After_Save_Logic con tutta la logica di business.</description>
    <environments>Default</environments>
    <formulas>
        <name>ContemporaneiChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Eventi_in_contemporanea__c})</expression>
    </formulas>
    <formulas>
        <name>ErrorManagementText</name>
        <dataType>String</dataType>
        <expression>IF(!ISNULL({!$Record.AccountId}), &quot;Account &quot; &amp; {!$Record.Account.Name}, &quot;Lead &quot; &amp; {!$Record.Lead__r.FirstName} &amp; &quot; &quot; &amp; {!$Record.Lead__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>EventEndDateChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Event_End_Date__c})</expression>
    </formulas>
    <formulas>
        <name>EventStartDateChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Event_Start_Date__c})</expression>
    </formulas>
    <formulas>
        <name>IsCreateFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>LeadChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Lead__c})</expression>
    </formulas>
    <formulas>
        <name>LocationChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Location__c})</expression>
    </formulas>
    <formulas>
        <name>PriorStageClosedLostFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record__Prior.StageName}, &apos;Chiuse/Perse&apos;)</expression>
    </formulas>
    <formulas>
        <name>ReminderSentChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.TECH_ReminderSent__c})</expression>
    </formulas>
    <formulas>
        <name>StageBecameClosedWonFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.StageName}, &apos;Chiuse/Conseguite&apos;) &amp;&amp;
(
ISNEW() ||
(ISCHANGED({!$Record.StageName}) &amp;&amp; !ISPICKVAL({!$Record__Prior.StageName}, &apos;Chiuse/Conseguite&apos;))
)</expression>
    </formulas>
    <formulas>
        <name>TuttoOrganizzatoChangedFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Tutto_Organizzato__c})</expression>
    </formulas>
    <interviewLabel>Opportunity After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>584</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Call_Opportunity_After_Save_Logic</targetReference>
        </connector>
        <filterFormula>{!$Record.Opp_automatica_da_web__c} = false &amp;&amp;
(
ISNEW() ||
(
!ISPICKVAL({!$Record.StageName}, &apos;Chiuse/Perse&apos;) &amp;&amp;
!ISPICKVAL({!$Record__Prior.StageName}, &apos;Chiuse/Perse&apos;) &amp;&amp;
!ISCHANGED({!$Record.TECH_ReminderSent__c}) &amp;&amp;
!ISCHANGED({!$Record.Eventi_in_contemporanea__c}) &amp;&amp;
(
!ISNULL({!$Record.AccountId}) ||
(!ISNULL({!$Record.Lead__c}) &amp;&amp; !ISPICKVAL({!$Record.Lead__r.LeadSource}, &apos;Website&apos;)) ||
ISCHANGED({!$Record.Location__c}) ||
ISCHANGED({!$Record.Tutto_Organizzato__c}) ||
ISCHANGED({!$Record.Event_Start_Date__c}) ||
ISCHANGED({!$Record.Event_End_Date__c}) ||
ISCHANGED({!$Record.Lead__c}) ||
ISCHANGED({!$Record.StageName})
)
)
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Opportunity_After_Save_Logic</name>
        <label>Call Opportunity After Save Logic</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Check_Fault_Stage</targetReference>
        </connector>
        <flowName>Opportunity_After_Save_Logic</flowName>
        <inputAssignments>
            <name>OpportunityRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>IsCreate</name>
            <value>
                <elementReference>IsCreateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>LocationChanged</name>
